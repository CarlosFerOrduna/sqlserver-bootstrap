# --- Server (docker-compose.yml) -------------------------------------------

# sa password. Min 8 chars, using 3 of: uppercase, lowercase, digits, symbols.
MSSQL_SA_PASSWORD=ChangeMe_Str0ng!Pass

# Image for the server and restore-mssql. Keep it >= the version your backups come from.
# MSSQL_IMAGE=mcr.microsoft.com/mssql/server:2022-CU27-GDR1-ubuntu-22.04

# Host port to publish (not MSSQL_TCP_PORT, which is the port inside the container).
MSSQL_PORT=1433

# Uncomment to enable SQL Server Agent — required for CDC capture jobs.
# MSSQL_AGENT_ENABLED=true

# --- Restore (scripts/restore-db.sh) ---------------------------------------

# Name to restore the backup as — not the name stored inside the .bak.
MSSQL_DATABASE=mydb

# Backup to restore, by file name inside baks/. Required when baks/ holds more than one.
# BAK_FILE=mydb_20240101.bak

# Backup set to restore (RESTORE ... WITH FILE = n). Required when the file holds more than one.
# BAK_FILE_POSITION=1

# Map restored database users to existing server logins (user:login, comma-separated).
# DB_USER_LOGINS=app_user:app_login
