DB_USER=sa

# Min 8 chars, using 3 of: uppercase, lowercase, digits, symbols.
DB_PASS=ChangeMe_Str0ng!Pass

# Name to restore the backup as — not the name stored inside the .bak.
DB_DATABASE=mydb

# Host port to publish.
DB_PORT=1433

# Uncomment to enable SQL Server Agent — required for CDC capture jobs.
# MSSQL_AGENT_ENABLED=true
